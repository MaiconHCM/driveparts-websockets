# Em Docker, defina NODE_ENV=production no VPS.
# Atenção: dentro do container, 127.0.0.1/localhost referem-se ao próprio
# container. Para alcançar serviços instalados no host do VPS (Mongo/Redis),
# use host.docker.internal no lugar de 127.0.0.1.
NODE_ENV=development
PORT=3010
LOG_LEVEL=info

# Preferido para execução direta e para os composes com Mongo externo.
# Informe a URL completa e codifique caracteres especiais das credenciais.
MONGODB_URL=
# Compatibilidade com a stack atual: se MONGODB_URL estiver vazia, os composes
# externos montam a URL existente usando esta senha. Não defina as duas sem necessidade.
MONGODB_PASSWORD=
MONGODB_DB=driveparts
MONGODB_TRANSACTIONS_ENABLED=true

DRIVEPARTS_INTERNAL_TOKEN=change_this_internal_token
WEBSOCKET_JWT_SECRET=change_this_socket_jwt_secret

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000,https://mercadodrive.com.br,https://www.mercadodrive.com.br,https://mercadodrivehomologacao.saken2.virtuaserver.com.br
SOCKET_PATH=/socket.io

# Opcional em instância única; recomendado para presença, cache, rate limit e scale-out.
# Em Docker com Redis externo no host do VPS: redis://host.docker.internal:6379
REDIS_URL=
REDIS_KEY_PREFIX=driveparts:websocket:development:v1
# Cache curto dos snapshots iniciais. Use 0 para desativar.
REDIS_SYNC_CACHE_TIME_TO_LIVE_SECONDS=15
# Expiração de sockets de uma instância que caiu sem executar o disconnect.
REDIS_SOCKET_PRESENCE_TIME_TO_LIVE_SECONDS=90
PRESENCE_PERSIST_INTERVAL_SECONDS=15

SOCKET_CONNECTION_RECOVERY_SECONDS=0
SOCKET_MAX_HTTP_BUFFER_SIZE_BYTES=65536
SOCKET_MAX_IN_FLIGHT_EVENTS=8
# Ative somente depois que DriveParts PHP e MercadoDrive enviarem todas as permissions.
SOCKET_ENFORCE_PERMISSIONS=false
# Compatibilidade temporária para tokens antigos sem user_role=master.
ALLOW_LEGACY_STORE_ID_MASTER_ROLE=false

ECOMMERCE_CUSTOMER_RATE_LIMIT_MAX=10
ECOMMERCE_CUSTOMER_RATE_LIMIT_WINDOW_SECONDS=60

# Usado APENAS pelo compose.internal.yaml (stack self-contained com Mongo interno).
# Define as credenciais do Mongo interno; o compose monta o MONGODB_URL a partir delas.
MONGO_ROOT_USER=driveparts
MONGO_ROOT_PASSWORD=change_this_mongo_root_password

MAX_CHAT_MESSAGE_LENGTH=4000
